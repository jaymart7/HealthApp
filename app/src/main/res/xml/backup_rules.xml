<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup for API 30 and below. `data_extraction_rules.xml` is the same decision for
    31+.

    Exclude-only, deliberately: an include list has to name `fitpulse.db` *and* its `-wal` and
    `-shm` companions, and a forgotten one restores a truncated database. Everything in `filesDir`
    goes — the Room database and the weekly backup JSON — except the progress photos, which are
    the one thing that can blow Auto Backup's 25 MB cap, and which the export has never carried
    either.
-->
<full-backup-content>
    <exclude domain="file" path="progress_photos/" />
</full-backup-content>
