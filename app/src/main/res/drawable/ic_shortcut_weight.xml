<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher shortcut icon. The circle and the glyph carry literal colours for
  ic_notification.xml's reason: a resource the launcher inflates cannot read a Compose
  theme token. The circle is @color/shortcut_background so the glyph stays legible on a
  light or a dark launcher, which a bare tinted glyph would not.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/shortcut_background"
        android:pathData="M12,12m-12,0a12,12 0 1,0 24,0a12,12 0 1,0 -24,0" />
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.55"
        android:scaleY="0.55">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M5,3h14a2,2 0 0 1 2,2v14a2,2 0 0 1 -2,2H5a2,2 0 0 1 -2,-2V5a2,2 0 0 1 2,-2zM12,6a4,4 0 0 0 -3.87,3h7.74A4,4 0 0 0 12,6zM11.1,8.4L12,6.6 12.9,8.4z" />
    </group>
</vector>
