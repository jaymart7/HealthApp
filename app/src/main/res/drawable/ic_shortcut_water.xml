<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher shortcut icon. The circle and the glyph carry literal colours for
  ic_notification.xml's reason: a resource the launcher inflates cannot read a Compose
  theme token. The circle is @color/shortcut_background so the glyph stays legible on a
  light or a dark launcher, which a bare tinted glyph would not.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/shortcut_background"
        android:pathData="M12,12m-12,0a12,12 0 1,0 24,0a12,12 0 1,0 -24,0" />
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.55"
        android:scaleY="0.55">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,2c-5.33,4.55 -8,8.48 -8,11.8 0,4.98 3.8,8.2 8,8.2s8,-3.22 8,-8.2c0,-3.32 -2.67,-7.25 -8,-11.8z" />
    </group>
</vector>
