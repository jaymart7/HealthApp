<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher shortcut icon. The circle and the glyph carry literal colours for
  ic_notification.xml's reason: a resource the launcher inflates cannot read a Compose
  theme token. The circle is @color/shortcut_background so the glyph stays legible on a
  light or a dark launcher, which a bare tinted glyph would not.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/shortcut_background"
        android:pathData="M12,12m-12,0a12,12 0 1,0 24,0a12,12 0 1,0 -24,0" />
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.55"
        android:scaleY="0.55">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M12,3a3,3 0 0 1 3,3v5a3,3 0 0 1 -6,0V6a3,3 0 0 1 3,-3z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M17,11a5,5 0 0 1 -10,0H5a7,7 0 0 0 6,6.92V20H8v2h8v-2h-3v-2.08A7,7 0 0 0 19,11z" />
    </group>
</vector>
