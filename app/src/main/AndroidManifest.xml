<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reminders post notifications; the switches live in Profile and the schedule in ph.mart.healthapp.reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets SpeechRecognizer.isRecognitionAvailable() answer on API 30+, which is what hides
         the "say what you ate" mic on a device with no recognizer rather than showing a button
         that fails on tap. FitPulse never binds a RecognitionService itself — the transcript
         comes back from the system's own dialog. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".FitPulseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitPulse">
        <!-- singleTop because a launcher shortcut's intent cannot carry flags (@xml/shortcuts
             inflates action/target/extras, not flags): without it a shortcut tapped on a running
             app would stack a second MainActivity instead of reaching onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FitPulse"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect's "why does this app want my data?" tap, for Android 13 and
                 below. It lands here rather than on a screen of its own because MainActivity is
                 the app's only Activity and every route is a Nav3 key inside its back stack — the
                 same reason @xml/shortcuts carries EXTRA_ACTION. See ShortcutAction.HealthSync. -->
            <intent-filter>
                <action android:name="androidx.health.connect.action.SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The same tap on Android 14+, where Health Connect is part of the platform and routes
             it through the permission-usage intent instead. An alias rather than a second Activity
             so both paths reach one screen; the START_VIEW_PERMISSION_USAGE permission is what
             stops anything but the system launching it. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />

                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The water reminder's "+1 glass" button. Not exported: nothing outside the app has any
             business logging a glass, and the notification's own PendingIntent is not a caller. -->
        <receiver
            android:name=".reminder.WaterActionReceiver"
            android:exported="false" />

        <!-- The home-screen widget. Exported because the launcher hosts it; it carries no data
             of its own and every read goes through the same repositories the app uses. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- The watch's two writes (a glass, a fast) arrive here. Exported because Play
             Services binds it; the path prefix is what keeps one filter covering both, and the
             service reads nothing it wasn't sent — every value is re-read from Room. -->
        <service
            android:name=".wear.PhoneWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/fitpulse/" />
            </intent-filter>
        </service>

        <!-- Grants a read on one rendered PNG at a time so the share chooser's target can open
             it; scoped to cacheDir/share (see @xml/file_paths), never filesDir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>