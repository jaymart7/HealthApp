<resources>
    <string name="coach_failure_offline">You\'re offline — the coach needs a connection.</string>
    <string name="coach_failure_failed">The coach couldn\'t answer that just now.</string>
    <string name="coach_retry">Try again</string>

    <!-- The long-press menu on an answer. "Ask again" only appears on the newest one. -->
    <string name="coach_bubble_actions">Answer options</string>
    <string name="coach_bubble_copy">Copy</string>
    <string name="coach_bubble_share">Share</string>
    <string name="coach_bubble_ask_again">Ask again</string>
    <string name="coach_clear">Clear chat</string>
    <string name="coach_clear_title">Clear this chat?</string>
    <string name="coach_clear_body">The whole conversation goes. Your logged food and weight aren\'t affected.</string>
    <string name="coach_clear_confirm">Clear</string>
    <string name="coach_clear_dismiss">Keep it</string>
    <string name="coach_input_placeholder">Ask your coach</string>
    <string name="coach_input_send">Send</string>
    <string name="coach_input_speak">Speak your question</string>
    <string name="coach_input_stop">Stop answering</string>
    <string name="coach_empty_greeting">Ask me about any day you\'ve logged — meals, macros, how the week\'s going.</string>
    <string name="coach_empty_limits">I can read your diary, and draft a log for you to confirm.</string>

    <!-- Openers for an empty conversation. Translated, unlike the prompts in :core:data: these are
         the user's own words, and what gets sent is whatever the button said. The first three are
         diary questions on purpose — before the coach had tools, all three were deflections. -->
    <string name="coach_starter_today">How am I doing today?</string>
    <string name="coach_starter_yesterday">What did I eat yesterday?</string>
    <string name="coach_starter_week">How has my week gone?</string>
    <string name="coach_starter_dinner">What should I eat tonight?</string>

    <!-- Follow-ups offered under a finished answer. Same rule as the starters: what gets sent is
         whatever the chip said, so these are translated. Each one is a question the coach can
         actually answer — three off the day it is told about, one through get_history. -->
    <string name="coach_followup_protein">What\'s a high-protein dinner?</string>
    <string name="coach_followup_water">Am I drinking enough water?</string>
    <string name="coach_followup_weight">How\'s my weight trending?</string>
    <string name="coach_followup_training">How has my training been?</string>

    <!-- The proposal card: the rows the coach drafted and the user has not agreed to yet. -->
    <string name="coach_proposal_food_title">Add to %1$s</string>
    <string name="coach_proposal_water_title">Add water</string>
    <string name="coach_proposal_water_body">%1$d glasses</string>
    <string name="coach_proposal_water_body_one">1 glass</string>
    <string name="coach_proposal_macros">%1$d kcal · %2$dg protein · %3$dg carbs · %4$dg fat</string>
    <string name="coach_proposal_exercise_title">Add activity</string>
    <!-- The burn is the app's own MET estimate from the user's weight, never the model's figure. -->
    <string name="coach_proposal_exercise_body">%1$d min · %2$d kcal burned</string>
    <string name="coach_proposal_weight_title">Add weigh-in</string>
    <!-- The figure and its unit, e.g. "82.4 kg". The unit is kg or lb, whichever the profile uses. -->
    <string name="coach_proposal_weight_body">%1$s %2$s</string>
    <!-- What the weigh-in moves by, e.g. "−0.6 kg since your last weigh-in". -->
    <string name="coach_proposal_weight_change">%1$s %2$s since your last weigh-in</string>
    <string name="coach_proposal_supplement_title">Mark as taken</string>
    <!-- A draft the coach backdated. The title carries the day, e.g. "Add to Breakfast ·
         Yesterday"; a draft for today says nothing, which is almost every draft. -->
    <string name="coach_proposal_title_day">%1$s · %2$s</string>
    <string name="coach_proposal_day_yesterday">Yesterday</string>
    <!-- How many doses the tick adds to today, e.g. "1 dose". Never the day's new total. -->
    <plurals name="coach_proposal_supplement_doses">
        <item quantity="one">%1$d dose</item>
        <item quantity="other">%1$d doses</item>
    </plurals>
    <!-- A draft holding more than one row: one title for the card, and one footer totalling what
         is still on it after any removals. -->
    <string name="coach_proposal_items_title">Add %1$d items</string>
    <string name="coach_proposal_items_total">%1$d kcal · %2$dg protein · %3$dg carbs · %4$dg fat</string>
    <string name="coach_proposal_row_kcal">%1$d kcal</string>
    <string name="coach_proposal_remove">Remove %1$s</string>
    <string name="coach_proposal_confirm">Log it</string>
    <string name="coach_proposal_dismiss">No thanks</string>

    <!-- Appended to the persisted answer once the user confirms, so reopening the chat still shows
         that something was logged. Resolved on the screen, never in the ViewModel. -->
    <string name="coach_proposal_logged_food">Logged: %1$s, %2$d kcal.</string>
    <string name="coach_proposal_logged_water">Logged: %1$s.</string>
    <string name="coach_proposal_logged_exercise">Logged: %1$s, %2$d min.</string>
    <string name="coach_proposal_logged_weight">Logged: %1$s.</string>
    <string name="coach_proposal_logged_supplement">Logged: %1$s.</string>
    <plurals name="coach_proposal_logged_items">
        <item quantity="one">Logged: %1$d item, %2$d kcal.</item>
        <item quantity="other">Logged: %1$d items, %2$d kcal.</item>
    </plurals>
</resources>
