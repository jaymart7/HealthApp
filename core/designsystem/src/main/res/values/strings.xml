    <!-- Google Health disclosure. The wording is a Restricted-scope requirement: one bullet per
         requested scope, in the order HEALTH_SCOPES asks for them. -->
    <string name="ds_health_title">FitPulse and Google Health</string>
    <string name="ds_health_intro">FitPulse collects health and fitness data from Google Health to show your workouts and steps and the calories they burned, track your weight trend, and show your heart rate and how you slept. It also sends the meals and water you log to Google Health, so your nutrition stays in one place.</string>
    <string name="ds_health_scope_activity">Workouts and activity</string>
    <string name="ds_health_scope_activity_body">Imported so your workouts and daily steps raise your calorie budget.</string>
    <string name="ds_health_scope_body">Weight, body measurements and heart rate</string>
    <string name="ds_health_scope_body_body">Imported so your weight trend and goal date use your real weigh-ins, and to show your daily heart rate.</string>
    <string name="ds_health_scope_sleep">Sleep</string>
    <string name="ds_health_scope_sleep_body">Imported to show last night\'s sleep on your home screen.</string>
    <string name="ds_health_scope_nutrition">Nutrition and hydration</string>
    <string name="ds_health_scope_nutrition_body">The meals and water you log in FitPulse are sent to Google Health.</string>
    <string name="ds_health_storage">Your health data is stored on this device. FitPulse never sells or shares it, and doesn\'t upload it anywhere except Google Health. You can disconnect and delete it at any time from Profile.</string>
    <string name="ds_health_connect">Connect Google Health</string>

